# Ghostty terminal for Arch + Caelestia (see hypr-vars.lua for its keybinds).
# Managed by the arch-desktop overlay (home-arch/); Arch-only, reapplied by
# arch_desktop_deploy_overlay. The shared home/ Ghostty config stays
# DMS-themed for Fedora and is never edited here: on Arch this copy replaces
# the stowed file (backed up first), on Fedora it is never deployed.
#
# No colours here on purpose. Caelestia writes the active scheme as escape
# sequences to ~/.local/state/caelestia/sequences.txt and its fish config
# replays them at every interactive start, so the palette follows the scheme
# live. Setting colours in this file would freeze them instead.
#
# The rest mirrors Caelestia's own foot.ini so both terminals match.
font-family = JetBrains Mono Nerd Font
font-size = 12
window-padding-x = 25
window-padding-y = 25
# Keep Ghostty internally opaque so the Hyprland opacity toggle is the sole
# owner of transparency and can make terminal windows completely opaque.
background-opacity = 1
cursor-style = bar
