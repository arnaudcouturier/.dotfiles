# Standalone terminal preferences: no desktop-generated theme.
font-size = 12
window-decoration = false
window-padding-x = 12
window-padding-y = 12
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
confirm-close-surface = false
app-notifications = false

# Personal shortcuts; all other bindings stay upstream defaults.
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

gtk-titlebar = false
# Keep prompt cursor changes disabled without contradictory cursor flags.
shell-integration-features = sudo,title,no-cursor
gtk-single-instance = true
