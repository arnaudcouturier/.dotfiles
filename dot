#!/usr/bin/env bash
set -euo pipefail

# dot — the only script in this repo.
# Arch Linux, opinionated, idempotent.
#
#   ./dot init              full setup: helpers + packages + herdr + stow + herdr plugins + fish shell
#   ./dot stow              (re)link home/ into $HOME, overwriting conflicts
#   ./dot doctor            verify helpers, packages, symlinks, login shell
#   ./dot check-packages    list bundle packages missing from this machine
#   ./dot package add NAME [--aur]     add to bundle and install it
#   ./dot package remove NAME          remove from bundle and uninstall it
#   ./dot package list                 show the bundle file
#   ./dot update            git pull + install + restow
#   ./dot benchmark-shell   time fish startup over N runs
#
# Conventions: home/ mirrors $HOME (home/.config/fish -> ~/.config/fish).
# packages/bundle holds `repo "..."` (pacman) and `aur "..."` (yay) lines.

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly DOTFILES_DIR
readonly HOME_DIR="${DOTFILES_DIR}/home"
readonly BUNDLE_FILE="${DOTFILES_DIR}/packages/bundle"

if [[ -t 1 ]]; then
  readonly C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m'
  readonly C_CYAN=$'\e[1;36m' C_GREEN=$'\e[1;32m' C_YELLOW=$'\e[1;33m' C_RED=$'\e[1;31m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED=''
fi

log_step() { printf '\n%s[*]%s %s%s\n' "${C_CYAN}" "${C_RESET}" "${C_BOLD}" "$*${C_RESET}"; }
log_ok() { printf '%s[+]%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"; }
log_info() { printf '%s[i]%s %s\n' "${C_DIM}" "${C_RESET}" "$*"; }
log_warn() { printf '%s[!]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
log_error() { printf '%s[x]%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; }
die() { log_error "$*"; exit 1; }

usage() {
  sed -n '/^# dot/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  cat <<'EOF'
Usage:
  ./dot init
  ./dot stow
  ./dot doctor
  ./dot check-packages
  ./dot package add NAME [--aur]
  ./dot package remove NAME
  ./dot package list
  ./dot update
  ./dot benchmark-shell
  ./dot help
EOF
}

require_user() {
  ((EUID != 0)) || die 'Run ./dot as your regular user, not root. It calls sudo itself when needed.'
}

# Keep sudo credentials alive during installation; stop the refresher on exit.
ELEVATION_PID=''
CLEANUP_PATH=''

# Remove the current temporary file or directory and stop sudo refresh on exit.
cleanup_dot() {
  end_elevation
  if [[ -n ${CLEANUP_PATH} ]]; then
    rm -rf -- "${CLEANUP_PATH}"
  fi
}
trap cleanup_dot EXIT

end_elevation() {
  if [[ -n ${ELEVATION_PID} ]]; then
    # Kill the refresher's sleep child first: killing only the subshell
    # orphans sleep, and the loop would then refresh sudo forever.
    if command -v pkill >/dev/null 2>&1; then
      pkill -P "${ELEVATION_PID}" 2>/dev/null || true
    fi
    kill "${ELEVATION_PID}" 2>/dev/null || true
    wait "${ELEVATION_PID}" 2>/dev/null || true
    ELEVATION_PID=''
  fi
}

begin_elevation() {
  ((EUID != 0)) || return 0
  command -v sudo >/dev/null 2>&1 || die 'sudo is required but missing.'
  log_info 'sudo will ask for your password once; it covers the whole run.'
  sudo -v || die 'sudo authentication failed.'
  # Refresh well inside sudo's 5-minute timestamp_timeout (man sudoers).
  ( while sleep 120; do sudo -n -v 2>/dev/null || exit 0; done ) >/dev/null 2>&1 &
  ELEVATION_PID=$!
}

require_arch() {
  [[ -r /etc/arch-release ]] || die 'This repo requires Arch Linux.'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

# Normalize one bundle line into ENTRY_VERB / ENTRY_NAME. Returns 1 for
# blank lines and comments (callers print those through verbatim).
parse_bundle_line() {
  local line=$1 rest
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [[ -z "${line}" || "${line}" == \#* ]] && return 1
  [[ "${line}" =~ ^(repo|aur)[[:space:]]+([^[:space:]#]+)(.*)$ ]] \
    || die "Cannot parse bundle line: ${line} (expected: repo \"name\" or aur \"name\")"
  ENTRY_VERB=${BASH_REMATCH[1]}
  ENTRY_NAME=${BASH_REMATCH[2]}
  ENTRY_NAME=${ENTRY_NAME#\"}; ENTRY_NAME=${ENTRY_NAME%\"}
  ENTRY_NAME=${ENTRY_NAME#\'}; ENTRY_NAME=${ENTRY_NAME%\'}
  [[ -n "${ENTRY_NAME}" ]] || die "Empty package name in bundle line: ${line}"
  rest=${BASH_REMATCH[3]}
  rest=${rest#"${rest%%[![:space:]]*}"}
  [[ -z "${rest}" || "${rest}" == \#* ]] \
    || die "Cannot parse bundle line: ${line} (trailing text after package name)"
  return 0
}

# Parse packages/bundle into REPO_PKGS and AUR_PKGS arrays.
# Accepts: repo "foo", aur 'foo', repo foo — trailing # comments allowed.
parse_bundle() {
  REPO_PKGS=()
  AUR_PKGS=()
  [[ -r "${BUNDLE_FILE}" ]] || die "Missing bundle file: ${BUNDLE_FILE}"
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    parse_bundle_line "${line}" || continue
    if [[ "${ENTRY_VERB}" == repo ]]; then
      REPO_PKGS+=("${ENTRY_NAME}")
    else
      AUR_PKGS+=("${ENTRY_NAME}")
    fi
  done <"${BUNDLE_FILE}"
}

ensure_helpers() {
  if ! command -v yay >/dev/null 2>&1; then
    # Bootstrap the AUR helper as a regular user.
    require_command git
    log_step 'Bootstrapping yay-bin from the AUR'
    sudo pacman -Syu --needed --noconfirm base-devel git
    require_command makepkg
    local tmpdir
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/yay-bin.XXXXXX")" \
      || die 'Failed to create temp dir for yay bootstrap.'
    CLEANUP_PATH=${tmpdir}
    git clone --depth 1 https://aur.archlinux.org/yay-bin.git "${tmpdir}" \
      || die 'Failed to clone yay-bin from the AUR (network or AUR unreachable).'
    (cd -- "${tmpdir}" && makepkg -si --noconfirm) \
      || die 'Failed to build and install yay-bin.'
    rm -rf -- "${tmpdir}"
    CLEANUP_PATH=''
    command -v yay >/dev/null 2>&1 || die 'yay bootstrap finished but yay is still missing.'
    log_ok 'yay installed.'
  fi
  if ! command -v stow >/dev/null 2>&1; then
    log_step 'Installing stow'
    sudo pacman -S --needed --noconfirm stow
  fi
}

# Install one package by scope: repo via pacman, aur via yay.
# Callers print their own context; this only runs the installer.
pkg_install() {
  local scope=$1 name=$2
  if [[ "${scope}" == repo ]]; then
    sudo pacman -Syu --needed --noconfirm -- "${name}"
  else
    require_command yay
    log_warn 'AUR PKGBUILDs are user-produced. Review the changes shown by yay before approving.'
    yay -S --aur --needed -- "${name}"
  fi
}

install_packages() {
  parse_bundle
  if ((${#REPO_PKGS[@]} > 0)); then
    log_step "Installing ${#REPO_PKGS[@]} repo package(s) with pacman"
    sudo pacman -Syu --needed --noconfirm "${REPO_PKGS[@]}"
  fi
  if ((${#AUR_PKGS[@]} > 0)); then
    require_command yay
    log_step "Installing ${#AUR_PKGS[@]} AUR package(s) with yay"
    log_warn 'AUR PKGBUILDs are user-produced. Review the changes shown by yay before approving.'
    yay -S --aur --needed "${AUR_PKGS[@]}"
  fi
  log_ok 'Packages installed.'
}

# Install Herdr with its upstream installer when missing.
ensure_herdr() {
  local found
  export PATH="${HOME}/.local/bin:${PATH}"
  if found="$(command -v herdr 2>/dev/null)"; then
    log_ok "herdr already installed: ${found}"
    return 0
  fi
  require_command curl
  require_command sh
  log_step 'Installing herdr via the official installer (herdr.dev/install.sh)'
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/herdr-install.XXXXXX.sh")" \
    || die 'Failed to create temp file for the herdr installer.'
  CLEANUP_PATH=${tmp}
  curl -fsSL --retry 3 https://herdr.dev/install.sh -o "${tmp}" \
    || die 'Failed to download the herdr installer (network or herdr.dev unreachable).'
  sh "${tmp}" || die 'The herdr installer failed.'
  rm -f -- "${tmp}"
  CLEANUP_PATH=''
  hash -r 2>/dev/null || true
  if found="$(command -v herdr 2>/dev/null)"; then
    log_ok "herdr installed: ${found}"
  else
    die 'herdr installer finished but no herdr binary was found.'
  fi
}

stow_dotfiles() {
  require_command stow
  [[ -d "${HOME_DIR}" ]] || die "Missing home directory: ${HOME_DIR}"
  log_step "Linking home/ into ${HOME} (conflicts are overwritten, no backup)"
  local source_file relative target source_abs target_link
  while IFS= read -r -d '' source_file; do
    relative=${source_file#"${HOME_DIR}/"}
    target="${HOME}/${relative}"
    if [[ -d "${target}" && ! -L "${target}" ]]; then
      # find only yields files/symlinks, so a real directory here means a
      # file-vs-directory collision stow could never resolve. Fail loudly
      # instead of leaving it for stow to trip over later.
      die "Cannot stow ${relative}: ${target} is a directory."
    fi
    if [[ -e "${target}" || -L "${target}" ]]; then
      source_abs="$(realpath -m -- "${source_file}")"
      if [[ -L "${target}" ]]; then
        target_link="$(realpath -m -- "${target}")" || target_link=''
        if [[ "${target_link}" == "${source_abs}" ]]; then
          continue # already correctly stowed
        fi
      fi
      log_info "Overwriting ${target}"
      rm -rf -- "${target}"
    fi
    mkdir -p -- "$(dirname -- "${target}")"
  done < <(find "${HOME_DIR}" -mindepth 1 \( -name node_modules -o -name .gitignore \) -prune -o \( -type f -o -type l \) -print0 | sort -z)
  stow -R --no-folding --ignore='(^|/)node_modules(/|$)' -d "${DOTFILES_DIR}" -t "${HOME}" home
  log_ok 'Dotfiles stowed.'
}

sync_herdr_plugins() {
  local plugin_file="${HOME_DIR}/.config/herdr/plugins.txt"
  require_command herdr
  [[ -r "${plugin_file}" ]] || die "Missing Herdr plugin list: ${plugin_file}"
  log_step 'Syncing Herdr plugins'
  local line failed_plugins=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    log_info "Syncing Herdr plugin: ${line}"
    herdr plugin install "${line}" --yes || failed_plugins+=("${line}")
  done <"${plugin_file}"
  if (( ${#failed_plugins[@]} > 0 )); then
    die "Failed to sync Herdr plugin(s): ${failed_plugins[*]}"
  fi
  if herdr status server >/dev/null 2>&1; then
    herdr server reload-config >/dev/null \
      || log_warn 'Plugins synced, but the live server reload failed; restart herdr to pick them up.'
  fi
  log_ok 'Herdr plugins are up to date.'
}

set_fish_shell() {
  local fish_path current_shell install_user
  command -v fish >/dev/null 2>&1 || die 'fish is not installed. Run ./dot init again to install the bundle first.'
  fish_path="$(command -v fish)"
  grep -Fxq "${fish_path}" /etc/shells \
    || die "${fish_path} is missing from /etc/shells; chsh would reject it."
  install_user="$(id -un)"
  current_shell="$(getent passwd "${install_user}" | cut -d: -f7)"
  if [[ ${current_shell} == "${fish_path}" ]]; then
    log_ok "fish is already the login shell for ${install_user}."
  else
    log_step "Setting fish as the login shell for ${install_user}"
    chsh -s "${fish_path}" "${install_user}"
    log_warn "Login shell changed to ${fish_path}. It takes effect at the next login."
  fi
}

cmd_init() {
  require_user
  require_arch
  begin_elevation
  ensure_helpers
  install_packages
  ensure_herdr
  stow_dotfiles
  sync_herdr_plugins
  set_fish_shell
  log_ok 'Init complete. Restart the terminal to load the fish configuration.'
}

cmd_stow() {
  require_user
  stow_dotfiles
}

cmd_doctor() {
  local failed=0
  require_arch
  log_step 'Checking helpers'
  for cmd in yay stow fish git herdr; do
    if command -v "${cmd}" >/dev/null 2>&1; then
      log_ok "${cmd} found: $(command -v "${cmd}")"
    else
      log_error "${cmd} is missing."
      failed=1
    fi
  done

  log_step 'Checking login shell'
  local fish_path current_shell
  if command -v fish >/dev/null 2>&1; then
    fish_path="$(command -v fish)"
    current_shell="$(getent passwd "$(id -un)" | cut -d: -f7)"
    if [[ ${current_shell} == "${fish_path}" ]]; then
      log_ok "Login shell is fish (${fish_path})."
    else
      log_error "Login shell is ${current_shell:-none}, expected ${fish_path}. Run ./dot init."
      failed=1
    fi
  else
    log_error 'fish is not installed.'
    failed=1
  fi

  log_step 'Checking bundle packages'
  parse_bundle
  local pkg
  for pkg in "${REPO_PKGS[@]}" "${AUR_PKGS[@]}"; do
    if pacman -Q -- "${pkg}" >/dev/null 2>&1; then
      log_ok "${pkg} installed."
    else
      log_error "${pkg} is missing. Run ./dot init."
      failed=1
    fi
  done

  log_step 'Checking Herdr plugins'
  local plugin_file="${HOME_DIR}/.config/herdr/plugins.txt" plugin_line plugin_name installed_plugins
  if ! command -v herdr >/dev/null 2>&1; then
    log_error 'herdr is missing; skipping plugin check.'
    failed=1
  elif [[ ! -r "${plugin_file}" ]]; then
    log_error "Missing Herdr plugin list: ${plugin_file}."
    failed=1
  else
    installed_plugins="$(herdr plugin list 2>/dev/null || true)"
    while IFS= read -r plugin_line || [[ -n "${plugin_line}" ]]; do
      plugin_line=${plugin_line#"${plugin_line%%[![:space:]]*}"}
      plugin_line=${plugin_line%"${plugin_line##*[![:space:]]}"}
      [[ -z "${plugin_line}" || "${plugin_line}" == \#* ]] && continue
      plugin_name=${plugin_line##*/}
      if grep -Fq -- "${plugin_name}" <<<"${installed_plugins}"; then
        log_ok "${plugin_line} installed."
      else
        log_error "${plugin_line} is missing. Run ./dot init."
        failed=1
      fi
    done <"${plugin_file}"
  fi

  log_step 'Checking stowed symlinks'
  local source_file relative target expected actual
  while IFS= read -r -d '' source_file; do
    relative=${source_file#"${HOME_DIR}/"}
    target="${HOME}/${relative}"
    expected="$(realpath -m -- "${source_file}")"
    if [[ -L "${target}" ]]; then
      actual="$(realpath -m -- "${target}")" || actual=''
      if [[ ${actual} == "${expected}" ]]; then
        continue
      else
        log_error "${target} points elsewhere (expected ${expected}). Run ./dot stow."
        failed=1
      fi
    elif [[ -e "${target}" ]]; then
      log_error "${target} exists but is not a symlink. Run ./dot stow."
      failed=1
    else
      log_error "${target} is missing. Run ./dot stow."
      failed=1
    fi
  done < <(find "${HOME_DIR}" -mindepth 1 \( -name node_modules -o -name .gitignore \) -prune -o \( -type f -o -type l \) -print0 | sort -z)
  if ((failed == 0)); then
    log_ok 'All symlinks point at home/.'
  fi

  log_step "Checking for broken symlinks in ${HOME} (depth ≤ 3)"
  local broken
  broken="$(find "${HOME}" -maxdepth 3 -type l ! -exec test -e {} \; -print 2>/dev/null || true)"
  if [[ -n "${broken}" ]]; then
    log_warn 'Broken symlinks found (app runtime locks are normal):'
    printf '%s\n' "${broken}" >&2
  else
    log_ok 'No broken symlinks.'
  fi

  if ((failed > 0)); then
    log_error 'Doctor found problems listed above.'
    return 1
  fi
  log_ok 'Doctor passed: helpers, packages, symlinks, and login shell look good.'
}

cmd_check_packages() {
  parse_bundle
  local pkg missing=()
  for pkg in "${REPO_PKGS[@]}" "${AUR_PKGS[@]}"; do
    pacman -Q -- "${pkg}" >/dev/null 2>&1 || missing+=("${pkg}")
  done
  if (( ${#missing[@]} == 0 )); then
    log_ok 'All bundle packages are installed.'
  else
    log_warn "Missing ${#missing[@]} package(s):"
    printf '  %s\n' "${missing[@]}"
    return 1
  fi
}

bundle_contains() {
  local needle=$1 line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    parse_bundle_line "${line}" || continue
    if [[ "${ENTRY_NAME}" == "${needle}" ]]; then
      printf '%s\n' "${ENTRY_VERB}"
      return 0
    fi
  done <"${BUNDLE_FILE}"
  return 1
}

cmd_package_add() {
  local name=${1:-} scope='repo' arg
  shift || true
  [[ -n "${name}" ]] || die 'Usage: ./dot package add NAME [--aur]'
  for arg in "$@"; do
    case "${arg}" in
      --aur | -a) scope='aur' ;;
      *) die "Unknown flag for package add: ${arg}" ;;
    esac
  done
  require_user
  local existing
  if existing="$(bundle_contains "${name}")"; then
    die "'${name}' is already in the bundle as ${existing}."
  fi
  # Install first so a failed install cannot leave a phantom bundle entry.
  log_step "Installing ${scope} \"${name}\""
  pkg_install "${scope}" "${name}"
  printf '%s "%s"\n' "${scope}" "${name}" >>"${BUNDLE_FILE}"
  log_ok "Added ${scope} \"${name}\" to packages/bundle."
}

cmd_package_remove() {
  local name=${1:-}
  [[ -n "${name}" ]] || die 'Usage: ./dot package remove NAME'
  require_user
  local scope tmp
  scope="$(bundle_contains "${name}")" \
    || die "'${name}' is not in packages/bundle."
  # Rewrite via temp file beside the bundle + atomic rename, so a crash
  # can never truncate packages/bundle. Lines pass through byte-identical
  # except the one matching entry, which shares parse_bundle's normalizer.
  tmp="$(mktemp "${BUNDLE_FILE}.tmp.XXXXXX")"
  CLEANUP_PATH=${tmp}
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if parse_bundle_line "${line}" \
      && [[ "${ENTRY_VERB}" == "${scope}" && "${ENTRY_NAME}" == "${name}" ]]; then
      continue
    fi
    printf '%s\n' "${line}"
  done <"${BUNDLE_FILE}" >"${tmp}"
  mv -- "${tmp}" "${BUNDLE_FILE}"
  CLEANUP_PATH=''
  log_ok "Removed ${scope} \"${name}\" from packages/bundle."
  log_step "Uninstalling ${name}"
  if [[ "${scope}" == repo ]]; then
    sudo pacman -Rns --noconfirm -- "${name}" || log_warn "pacman could not remove ${name} (maybe a dependency)."
  else
    yay -Rns --noconfirm -- "${name}" || log_warn "yay could not remove ${name}."
  fi
}

cmd_package_list() {
  cat -- "${BUNDLE_FILE}"
}

cmd_benchmark_shell() {
  command -v fish >/dev/null 2>&1 || die 'fish is not installed.'
  local runs=10 verbose=0
  while (($# > 0)); do
    case "$1" in
      -r | --runs)
        [[ $# -ge 2 ]] || die 'Usage: ./dot benchmark-shell [-r RUNS] [-v]'
        runs=$2
        shift 2
        ;;
      -v | --verbose)
        verbose=1
        shift
        ;;
      -h | --help)
        cat <<'EOF'
Usage: ./dot benchmark-shell [-r RUNS] [-v]

  -r, --runs NUM   Number of startup runs, 1-100 (default: 10)
  -v, --verbose    Show each run timing
EOF
        return 0
        ;;
      *)
        die "Unknown option: $1. See ./dot benchmark-shell --help."
        ;;
    esac
  done
  if ! [[ "${runs}" =~ ^[0-9]+$ ]] || ((runs < 1 || runs > 100)); then
    die 'Number of runs must be between 1 and 100.'
  fi
  log_step "Benchmarking fish startup (${runs} runs of an empty script)"
  local temp_script
  temp_script="$(mktemp -t dot-fish-benchmark-XXXXXX.fish)" \
    || die 'Failed to create temp file.'
  CLEANUP_PATH=${temp_script}
  echo 'exit 0' >"${temp_script}"
  local -a times=()
  local total=0 elapsed i
  for ((i = 1; i <= runs; i++)); do
    # Temp path travels via argv (sys.argv/@ARGV), never embedded in code,
    # so no quoting layer can turn it into a literal string.
    if command -v python3 >/dev/null 2>&1; then
      elapsed="$(python3 -c 'import sys,time,subprocess; s=time.time(); subprocess.run(["fish",sys.argv[1]],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); print(f"{time.time()-s:.3f}")' "${temp_script}")"
    elif command -v perl >/dev/null 2>&1; then
      elapsed="$(perl -MTime::HiRes=time -e '$s=time(); system("fish",$ARGV[0]); printf "%.3f",time()-$s' "${temp_script}" 2>/dev/null)"
    else
      SECONDS=0
      fish "${temp_script}" >/dev/null 2>&1
      elapsed="${SECONDS}"
      [[ "${elapsed}" == 0 ]] && elapsed='0.001'
    fi
    [[ "${elapsed}" =~ ^[0-9]*\.?[0-9]+$ ]] || elapsed='0.001'
    times+=("${elapsed}")
    total="$(awk -v a="${total}" -v b="${elapsed}" 'BEGIN { printf "%.3f", a + b }')"
    ((verbose)) && printf '  Run %2d: %.3f seconds\n' "${i}" "${elapsed}"
  done
  rm -f -- "${temp_script}"
  CLEANUP_PATH=''
  local avg min max
  avg="$(awk -v t="${total}" -v n="${runs}" 'BEGIN { printf "%.3f", t / n }')"
  min=${times[0]} max=${times[0]}
  local t
  for t in "${times[@]}"; do
    [[ $(awk -v a="${t}" -v b="${min}" 'BEGIN { print (a < b) }') == 1 ]] && min=${t}
    [[ $(awk -v a="${t}" -v b="${max}" 'BEGIN { print (a > b) }') == 1 ]] && max=${t}
  done
  log_ok "fish ${C_BOLD}$(fish --version)${C_RESET}: avg ${avg}s, fastest ${min}s, slowest ${max}s over ${runs} runs."
  if [[ $(awk -v a="${avg}" 'BEGIN { print (a <= 0.050) }') == 1 ]]; then
    log_ok 'Excellent startup performance (≤50ms).'
  elif [[ $(awk -v a="${avg}" 'BEGIN { print (a <= 0.100) }') == 1 ]]; then
    log_ok 'Good startup performance (≤100ms).'
  elif [[ $(awk -v a="${avg}" 'BEGIN { print (a <= 0.200) }') == 1 ]]; then
    log_warn 'Fair startup performance (≤200ms).'
  else
    log_warn 'Slow startup (>200ms). Check conf.d additions and starship timeout.'
  fi
}

cmd_package() {
  local sub=${1:-list}
  shift || true
  case "${sub}" in
    add) cmd_package_add "$@" ;;
    remove | rm) cmd_package_remove "$@" ;;
    list | ls) cmd_package_list ;;
    help | -h | --help) cat <<'EOF'
Usage:
  ./dot package add NAME [--aur]   add to bundle and install
  ./dot package remove NAME        remove from bundle and uninstall
  ./dot package list               show the bundle file
EOF
      ;;
    *) die "Unknown package subcommand: ${sub}. See ./dot package help." ;;
  esac
}

cmd_update() {
  require_user
  require_arch
  require_command git
  begin_elevation
  log_step 'Pulling latest dotfiles'
  git -C "${DOTFILES_DIR}" pull --rebase
  ensure_helpers
  install_packages
  ensure_herdr
  stow_dotfiles
  sync_herdr_plugins
  log_ok 'Update complete.'
}

main() {
  local cmd=${1:-help}
  shift || true
  case "${cmd}" in
    init) cmd_init "$@" ;;
    stow) cmd_stow "$@" ;;
    doctor) cmd_doctor "$@" ;;
    check-packages) cmd_check_packages "$@" ;;
    package) cmd_package "$@" ;;
    update) cmd_update "$@" ;;
    benchmark-shell) cmd_benchmark_shell "$@" ;;
    help | -h | --help) usage ;;
    *) die "Unknown command: ${cmd}. See ./dot help." ;;
  esac
}

main "$@"
