cmd_init() {
  require_user
  begin_elevation
  ensure_helpers
  install_packages
  install_tools
  ensure_nvidia
  stow_dotfiles
  stow_arch_overlay
  stow_fedora_overlay
  sync_herdr_plugins
  set_fish_shell
  if [[ ${DISTRO} == arch ]]; then
    log_info 'Arch system provisioning is separate and idempotent: ./dot arch-check, then ./dot arch-setup.'
  fi
  log_ok 'Init complete. Restart the terminal to load the fish configuration.'
}

cmd_update() {
  require_user
  require_command git
  begin_elevation
  log_step 'Pulling latest dotfiles'
  git -C "${DOTFILES_DIR}" pull --rebase
  ensure_helpers
  install_packages
  install_tools
  ensure_nvidia
  stow_dotfiles
  stow_arch_overlay
  stow_fedora_overlay
  sync_herdr_plugins
