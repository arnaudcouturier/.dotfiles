cmd_stow() {
  detect_distro
  require_user
  stow_dotfiles
  stow_arch_overlay
  stow_fedora_overlay
}

# Bundle entries missing from this machine, one `verb "name"` per line.
missing_entries() {
  local entry verb name url
  for entry in "${BUNDLE_ENTRIES[@]}"; do
    read -r verb name url <<<"${entry}"
    pkg_query "${verb}" "${name}" "${url}" || printf '%s "%s"\n' "${verb}" "${name}"
  done
}

cmd_check_packages() {
  parse_bundle
  local -a missing=()
  mapfile -t missing < <(missing_entries)
  if ((${#missing[@]} == 0)); then
    log_ok "Bundle is fully installed (${#BUNDLE_ENTRIES[@]} entries)."
    return 0
  fi
  log_warn "Missing ${#missing[@]} of ${#BUNDLE_ENTRIES[@]} bundle entries:"
  printf '  %s\n' "${missing[@]}"
  return 1
}

cmd_doctor() {
  local failed=0

  log_step 'Checking helpers'
  local -a helpers=(git stow fish herdr claude)
  [[ ${DISTRO} == arch ]] && helpers+=(yay)
  local cmd
  for cmd in "${helpers[@]}"; do
    command -v "${cmd}" >/dev/null 2>&1 || { log_error "${cmd} is missing."; failed=1; }
  done
  ((failed)) || log_ok "All helpers found: ${helpers[*]}"

  log_step 'Checking login shell'
  local shell current
  shell="$(command -v fish 2>/dev/null || true)"
  current="$(getent passwd "$(id -un)" | cut -d: -f7)"
  if [[ -n ${shell} && ${current} == "${shell}" ]]; then
    log_ok "Login shell is fish (${shell})."
  else
    log_error "Login shell is ${current:-none}, expected fish. Run ./dot init."
    failed=1
  fi

  log_step 'Checking bundle packages'
  parse_bundle
  local -a missing=()
  mapfile -t missing < <(missing_entries)
  if ((${#missing[@]} == 0)); then
    log_ok "Bundle is fully installed (${#BUNDLE_ENTRIES[@]} entries)."
  else
    log_error "Missing ${#missing[@]} bundle entries (run ./dot init):"
    printf '  %s\n' "${missing[@]}" >&2
    failed=1
  fi

  log_step 'Checking Herdr plugins'
  if ! command -v herdr >/dev/null 2>&1; then
    log_error 'herdr is missing; skipping the plugin check.'
    failed=1
  else
    local installed plugins plugin plugin_failed=0
    installed="$(herdr plugin list 2>/dev/null || true)"
    plugins="$(herdr_plugins)"
    while IFS= read -r plugin; do
      [[ -n ${plugin} ]] || continue
      grep -Fq -- "${plugin##*/}" <<<"${installed}" && continue
      log_error "${plugin} is missing. Run ./dot init."
      plugin_failed=1
    done <<<"${plugins}"
    if ((plugin_failed)); then failed=1; else log_ok 'All Herdr plugins installed.'; fi
  fi

  log_step 'Checking stowed symlinks'
  local src rel target content link_failed=0
  while IFS= read -r -d '' src; do
    rel=${src#"${HOME_DIR}/"}
    # Forwarding aliases are never asserted from shared home/ on any distro;
    # each distro asserts its own real copy from its own tree below.
    home_path_is_compat_forward "${rel}" && continue
    target="${HOME}/${rel}"
    if [[ ! -L ${target} ]]; then
      log_error "${target} is not a symlink into home/. Run ./dot stow."
      link_failed=1
    elif [[ "$(realpath -m -- "${target}")" != "$(realpath -m -- "${src}")" ]]; then
      log_error "${target} points elsewhere. Run ./dot stow."
      link_failed=1
    fi
  done < <(home_files)
  if [[ ${DISTRO} == arch && -d ${ARCH_HOME_OVERLAY_DIR} ]]; then
    arch_source_desktop_quiet \
      || die 'lib/arch-desktop.sh is missing but home-arch/ is present; cannot verify the overlay.'
    declare -F arch_desktop_is_deployed_file >/dev/null 2>&1 \
      || die 'lib/arch-desktop.sh does not provide arch_desktop_is_deployed_file; coordinate the API before proceeding.'
    while IFS= read -r -d '' src; do
      rel=${src#"${ARCH_HOME_OVERLAY_DIR}/"}
      # Deployed user files are real files by design (see stow_arch_overlay);
      # the symlink assertion below never applies to them.
      arch_desktop_is_deployed_file "${rel}" && continue
      target="${HOME}/${rel}"
      if [[ ! -L ${target} ]]; then
        log_error "${target} is not a symlink into home-arch/. Run ./dot stow."
        link_failed=1
      elif [[ "$(realpath -m -- "${target}")" != "$(realpath -m -- "${src}")" ]]; then
        log_error "${target} points elsewhere. Run ./dot stow."
        link_failed=1
      fi
    done < <(arch_overlay_files)
    while IFS= read -r rel; do
      [[ -n ${rel} ]] || continue
      target="${HOME}/${rel}"
      if [[ -L ${target} ]]; then
        log_error "${target} is a legacy symlink, not a deployed user file. Run ./dot stow."
        link_failed=1
      elif [[ ! -f ${target} ]]; then
        log_error "${target} is not deployed. Run ./dot stow."
        link_failed=1
      else
        content="$(cat -- "${target}")"
        if [[ -z ${content} || ${content} == 'return {}' ]]; then
          log_error "${target} is an unconfigured compositor placeholder. Run ./dot stow."
          link_failed=1
        fi
      fi
    done < <(arch_desktop_deployed_relpaths)
  fi
  if [[ ${DISTRO} == fedora && -d ${FEDORA_HOME_OVERLAY_DIR} ]]; then
    while IFS= read -r -d '' src; do
      rel=${src#"${FEDORA_HOME_OVERLAY_DIR}/"}
      target="${HOME}/${rel}"
      if [[ ! -L ${target} ]]; then
        log_error "${target} is not a symlink into home-fedora/. Run ./dot stow."
        link_failed=1
      elif [[ "$(realpath -m -- "${target}")" != "$(realpath -m -- "${src}")" ]]; then
        log_error "${target} points elsewhere. Run ./dot stow."
        link_failed=1
      fi
    done < <(fedora_overlay_files)
  fi
  if ((link_failed)); then failed=1; else log_ok 'All symlinks point at their selected sources.'; fi

  ((failed == 0)) || die 'Doctor found the problems listed above.'
  log_ok 'Doctor passed: helpers, packages, plugins, symlinks, and login shell look good.'
}

cmd_package_add() {
  local name=${1:-} verb='repo' url='' flag
  shift || true
  [[ -n ${name} ]] || die 'Usage: ./dot package add NAME|URL [--aur|--rpm|--flatpak|--repofile|--copr|--appimage|--npm|--npm-scripts]'
  # A flag names the bundle verb; require_verb_for_distro rejects the ones
  # this distro cannot use.
  for flag in "$@"; do
    [[ ${flag} == --* ]] || die "Unexpected argument for package add: ${flag}"
    verb=${flag#--}
    require_verb_for_distro "${verb}"
  done
  case "${verb}" in
    rpm | appimage)
      # These take the URL and record `verb "name" "URL"`, so the name is
      # resolved once, here, instead of guessed at every query.
      [[ ${name} == https://* ]] || die "${verb} entries need an https URL; got: ${name}"
      url=${name}
      if [[ ${verb} == appimage ]]; then
        [[ ${url} == *.AppImage ]] || die "appimage entries need a URL ending in .AppImage; got: ${url}"
        name="$(appimage_app "${url}")"
      else
        require_command rpm
        name="$(rpm -q --qf '%{NAME}' -p "${url}" 2>/dev/null)" \
          || die "Could not read the package name from ${url}. Check the URL, or add the entry to the bundle by hand."
      fi
      [[ -n ${name} ]] || die "Could not derive a name from ${url}."
      log_info "Recording ${verb} \"${name}\" from ${url}"
      ;;
    repofile)
      [[ ${name} == https://* ]] || die "repofile entries need an https URL; got: ${name}"
      ;;
    *)
      # Leading dash excluded: see parse_bundle_line.
      [[ ${name} =~ ^[@A-Za-z0-9._/+][@A-Za-z0-9._/+-]*$ ]] || die "Invalid ${verb} entry name: ${name}"
      ;;
  esac
  require_user
  parse_bundle
  local existing
  if existing="$(bundle_verb_of "${name}")"; then
    die "'${name}' is already in the bundle as ${existing}."
  fi
  # MEGA vendor repo first on Arch single-adds (the Thunar integration
  # packages resolve from it); silent for other names and distros.
  arch_mega_ensure_for_package "${verb}" "${name}"
  # Install first so a failed install cannot leave a phantom bundle entry.
  log_step "Installing ${verb} \"${name}\""
  pkg_install "${verb}" "${name}" "${url}"
  if [[ -n ${url} ]]; then
    printf '%s "%s" "%s"\n' "${verb}" "${name}" "${url}" >>"${BUNDLE_FILE}"
  else
    printf '%s "%s"\n' "${verb}" "${name}" >>"${BUNDLE_FILE}"
  fi
  log_ok "Added ${verb} \"${name}\" to ${BUNDLE_FILE#"${DOTFILES_DIR}/"}. Give it a trailing # purpose comment."
}

cmd_package_remove() {
  local name=${1:-}
  [[ -n ${name} ]] || die 'Usage: ./dot package remove NAME'
  require_user
  parse_bundle
  local verb tmp line url=''
  verb="$(bundle_verb_of "${name}")" || die "'${name}' is not in ${BUNDLE_FILE#"${DOTFILES_DIR}/"}."
  # Rewrite through a temp file beside the bundle, then rename: a crash can
  # never truncate the bundle. Every line but the match passes through
  # byte-identical.
  tmp="$(mktemp "${BUNDLE_FILE}.tmp.XXXXXX")"
  CLEANUP_PATH=${tmp}
  while IFS= read -r line || [[ -n ${line} ]]; do
    if parse_bundle_line "${line}" && [[ ${ENTRY_VERB} == "${verb}" && ${ENTRY_NAME} == "${name}" ]]; then
      url=${ENTRY_URL}
      continue
    fi
    printf '%s\n' "${line}"
  done <"${BUNDLE_FILE}" >"${tmp}"
  mv -- "${tmp}" "${BUNDLE_FILE}"
  CLEANUP_PATH=''
  log_ok "Removed ${verb} \"${name}\" from ${BUNDLE_FILE#"${DOTFILES_DIR}/"}."
  log_step "Uninstalling ${name}"
  pkg_remove "${verb}" "${name}" "${url}"
}

cmd_package() {
  local sub=${1:-list}
  shift || true
  case "${sub}" in
    add) cmd_package_add "$@" ;;
    remove | rm) cmd_package_remove "$@" ;;
    list | ls) cat -- "${BUNDLE_FILE}" ;;
    *) die "Unknown package subcommand: ${sub}. See ./dot help." ;;
  esac
}

# Time non-interactive fish startup: config.fish is sourced, the greeting and
# prompt are not.
cmd_benchmark_shell() {
  local runs=10
  while (($# > 0)); do
    case "$1" in
      -r | --runs)
        runs=${2:-}
        shift 2 || die 'Usage: ./dot benchmark-shell [-r RUNS]'
        ;;
      *) die "Unknown option: $1. Usage: ./dot benchmark-shell [-r RUNS]" ;;
    esac
  done
  if ! [[ ${runs} =~ ^[0-9]+$ ]] || ((runs < 1 || runs > 100)); then
    die 'Runs must be between 1 and 100.'
  fi
  local shell
  shell="$(fish_path)"
  [[ -n ${EPOCHREALTIME:-} ]] || die 'benchmark-shell needs bash 5 or newer.'
  log_step "Benchmarking fish startup (${runs} runs)"
  # EPOCHREALTIME is microseconds since the epoch (with a locale-dependent
  # decimal separator), which keeps this to integer shell math.
  local i start us total=0 min=0 max=0
  for ((i = 1; i <= runs; i++)); do
    start=${EPOCHREALTIME//[^0-9]/}
    "${shell}" -c 'exit 0' >/dev/null 2>&1
    us=$((${EPOCHREALTIME//[^0-9]/} - start))
    total=$((total + us))
    ((min == 0 || us < min)) && min=${us}
    ((us > max)) && max=${us}
    true
  done
  local avg=$((total / runs)) summary
  printf -v summary 'avg %d.%02dms, fastest %dms, slowest %dms over %d runs' \
    $((avg / 1000)) $((avg % 1000 / 10)) $((min / 1000)) $((max / 1000)) "${runs}"
  log_ok "fish startup: ${summary}"
  if ((avg > 100000)); then
    log_warn 'Above 100ms — check fish conf.d additions and the starship timeout.'
  fi
}

# --- Arch provisioning ------------------------------------------------------

# Canonical arch-setup/arch-check step order. Greeter runs after desktop
# verification in the same run (see arch_require_desktop_verified); Limine
# runs last, after the system it boots is stable.
ARCH_SETUP_STEPS=(system gpu snapshots desktop greeter video limine)

# Source one Arch provisioning module. Sourcing is side-effect free
# (definitions only), so arch-check stays non-mutating.
# Sourced-module registry. Re-sourcing a module with readonly globals dies
# under set -e, and one arch-setup run needs the desktop module twice
# (desktop step installs, greeter step re-verifies) — so every load below
# is idempotent, keyed by module name and marked only after a clean source.
declare -A DOT_SOURCED_MODULES=()

arch_source_once() {
  local key=$1 file=$2
  [[ -n ${DOT_SOURCED_MODULES[${key}]+x} ]] && return 0
  [[ -r ${file} ]] || die "Missing Arch provisioning module: ${file}"
  # shellcheck source=/dev/null
  source "${file}"
  DOT_SOURCED_MODULES[${key}]=1
}

arch_load_module() {
  arch_source_once "$1" "${ARCH_LIB_DIR}/$1"
}

arch_load_modules() {
  arch_load_module arch-guard.sh
  arch_load_module arch-system.sh
  arch_load_module arch-gpu.sh
  arch_load_module arch-snapshots.sh
  arch_load_module arch-greeter.sh
  arch_load_module arch-limine.sh
  arch_load_module arch-video.sh
}

# Source the desktop integration or fail loudly: complete arch-setup has no
# silent path past a missing desktop module. Owned by the arch-design agent.
# True when the desktop interface is already present, however it was
# loaded. Re-sourcing readonly globals would die under set -e, so presence
# — not the registry below — is the real loaded condition.
arch_desktop_is_loaded() {
  declare -F arch_desktop_verify_overlay >/dev/null 2>&1
}

# Source the desktop module once when the file exists; false when missing
# (the caller reports it). Never re-sources readonly globals.
arch_source_desktop_quiet() {
  arch_desktop_is_loaded && return 0
  [[ -r ${ARCH_DESKTOP_MODULE} ]] || return 1
  arch_source_once arch-desktop "${ARCH_DESKTOP_MODULE}"
}

arch_load_desktop_or_die() {
  arch_source_desktop_quiet || die 'Arch desktop module is missing: lib/arch-desktop.sh has not landed. Complete arch-setup needs it.'
}

# MEGA vendor repository integration (MEGA Sync + Thunar file manager
# plugin). The module file belongs to the arch-apps agent; dot only
# lazy-sources it and calls its three-function API, never implementing repo
# behavior itself.
# True when the MEGA interface is already present, however it was loaded.
# Re-sourcing readonly globals would die under set -e, so presence — not
# the registry below — is the real loaded condition.
arch_mega_is_loaded() {
  declare -F arch_mega_setup_vendor_repo >/dev/null 2>&1
}

# Source the MEGA module once when the file exists; false when missing
# (callers warn-skip until it lands). Never re-sources readonly globals.
arch_source_mega_quiet() {
  arch_mega_is_loaded && return 0
  [[ -r ${ARCH_MEGA_MODULE} ]] || return 1
  arch_source_once arch-mega "${ARCH_MEGA_MODULE}"
}

# True when the parsed bundle requests a MEGA vendor-repo package. Keeps
# the vendor source coupled to demand: removing the apps removes the repo
# setup, and an invalid bundle never reaches key trust. Canonical names
# mirror ARCH_MEGA_PACKAGES in the module; repo verb only (the AUR builds
# are a rejected route, never a demand signal).
bundle_requests_mega_repo() {
  local entry verb name _url
  for entry in "${BUNDLE_ENTRIES[@]}"; do
    read -r verb name _url <<<"${entry}"
    [[ ${verb} == repo ]] || continue
    [[ ${name} == megasync || ${name} == thunar-megasync ]] && return 0
  done
  return 1
}

# Ensure the MEGA vendor repo before any Arch package install. Arch-gated
# first (other distros return before any sourcing, sudo, or network) and
# runs under the caller's elevation; all mutation happens inside the module
# (verified key plus one pacman.conf section, fail-loud). A missing module
# is a transitional warn-skip: the bundle carries no MEGA lines until it
# lands, so nothing yet needs the repo.
ensure_mega_vendor_repo() {
  [[ ${DISTRO:-} == arch ]] || return 0
  arch_source_mega_quiet || {
    log_warn 'MEGA vendor module is missing: lib/arch-mega.sh has not landed; skipping repo setup.'
    return 0
  }
  declare -F arch_mega_setup_vendor_repo >/dev/null 2>&1 \
    || die 'lib/arch-mega.sh does not provide arch_mega_setup_vendor_repo; coordinate the API before proceeding.'
  arch_mega_setup_vendor_repo
}

# Pre-install gate for `dot package add` on Arch: only the two vendor-repo
# names trigger setup (canonical list: ARCH_MEGA_PACKAGES in the module).
# Anything else — and every other distro — returns silently.
arch_mega_ensure_for_package() {
  local verb=$1 name=$2
  [[ ${DISTRO:-} == arch && ${verb} == repo ]] || return 0
  [[ ${name} == megasync || ${name} == thunar-megasync ]] || return 0
  ensure_mega_vendor_repo
}

# The desktop draft predates the stow-based contract; require the interface
# it adapts to, with a message that names the fix instead of a bare
# "command not found" under set -e.
arch_require_desktop_interface() {
  local fn
  for fn in arch_desktop_install_overlay arch_desktop_configure_caelestia arch_desktop_verify_overlay arch_desktop_verify_caelestia; do
    declare -F "${fn}" >/dev/null 2>&1 \
      || die "lib/arch-desktop.sh does not provide ${fn}; it predates the stow-based contract."
  done
}

# Verify the desktop in place and refuse the dependent step on drift. The
# greeter must never enable beside an unverified desktop.
arch_require_desktop_verified() {
  arch_load_desktop_or_die
  arch_require_desktop_interface
  arch_desktop_verify_overlay \
    || die 'Desktop overlay is incomplete; refusing the dependent step. Fix it, then rerun.'
  arch_desktop_verify_caelestia \
    || die 'Caelestia integration is incomplete; refusing the dependent step. Fix it, then rerun.'
}

# Echo the selected steps, one per line, in canonical order. Dies on unknown
# names, empty picks, or an empty filter value.
arch_selected_steps() {
  local filter=${1:-all} step piece
  local -a wanted=()
  if [[ ${filter} != all ]]; then
    IFS=',' read -r -a wanted <<<"${filter}"
    for piece in "${wanted[@]}"; do
      local known=0
      for step in "${ARCH_SETUP_STEPS[@]}"; do
        [[ -n ${piece} && ${piece} == "${step}" ]] && known=1
      done
      ((known == 1)) || die "Unknown arch step: '${piece}'. Steps: ${ARCH_SETUP_STEPS[*]}."
    done
  fi
  for step in "${ARCH_SETUP_STEPS[@]}"; do
    if [[ ${filter} == all ]]; then
      printf '%s\n' "${step}"
      continue
    fi
    for piece in "${wanted[@]}"; do
      if [[ ${piece} == "${step}" ]]; then
        printf '%s\n' "${step}"
        break
      fi
    done
  done
}

# Provision this Arch machine. Helpers and the bundle install first, so a
# minimal archinstall reaches a working desktop from ./dot init plus this one
# command; every step is idempotent, so re-running repairs. Gating precedes
# sudo, network, and every system mutation.
cmd_arch_setup() {
  local only=all replace_dm=0
  while (($# > 0)); do
    case "$1" in
      --only) only=${2:-}; shift 2 || die 'Usage: ./dot arch-setup [--only step,...] [--replace-display-manager]' ;;
      --only=*) only=${1#*=}; shift ;;
      --replace-display-manager) replace_dm=1; shift ;;
      -h | --help) die 'Usage: ./dot arch-setup [--only step,...] [--replace-display-manager]' ;;
      *) die "Unknown option: $1. Usage: ./dot arch-setup [--only step,...] [--replace-display-manager]" ;;
    esac
  done
  [[ -n ${only} ]] || die 'Usage: ./dot arch-setup [--only step,...] [--replace-display-manager]'
  arch_load_modules
  require_arch_system
  # Validate the step filter before any elevation, network, or mutation:
  # an unknown step dies here, before helpers, bundle installs (and any
  # vendor-repo setup they demand), stow, or provisioning steps run.
  # Capture, then check: mapfile over a process substitution would mask a
  # dying filter under set -e and report success over zero steps.
  local steps_text steps_rc=0
  steps_text="$(arch_selected_steps "${only}")" || steps_rc=$?
  ((steps_rc == 0)) || die "Refusing to run with step filter '${only}' (see error above)."
  local -a steps=() step
  while IFS= read -r step; do
    [[ -n ${step} ]] || continue
    steps+=("${step}")
  done <<<"${steps_text}"
  ((${#steps[@]} > 0)) || die "Refusing an empty arch run with filter '${only}'."
  require_user
  begin_elevation
  ensure_helpers
  install_packages
  stow_dotfiles
  stow_arch_overlay
  for step in "${steps[@]}"; do
    case "${step}" in
      system) arch_system_setup ;;
      gpu) arch_gpu_setup_drivers ;;
      snapshots) arch_snapshots_setup ;;
      desktop)
        arch_load_desktop_or_die
        arch_require_desktop_interface
        arch_desktop_install_overlay
        arch_desktop_configure_caelestia
        arch_desktop_verify_overlay \
          || die 'Desktop overlay is incomplete after install.'
        arch_desktop_verify_caelestia \
          || die 'Caelestia integration is incomplete after configuration.'
        ;;
      greeter)
        arch_require_desktop_verified
        arch_greeter_setup "${replace_dm}"
        ;;
      video) arch_video_setup ;;
      limine) arch_limine_setup ;;
    esac
  done
  log_ok "Arch setup complete (${steps[*]}). Reboot, then run ./dot arch-check from a Hyprland session."
}

# Verify Arch provisioning without changing anything. No elevation: every
# probe is read-only (sudo-n tolerant where root-owned paths are involved).
cmd_arch_check() {
  local only=all
  while (($# > 0)); do
    case "$1" in
      --only) only=${2:-}; shift 2 || die 'Usage: ./dot arch-check [--only step,...]' ;;
      --only=*) only=${1#*=}; shift ;;
      -h | --help) die 'Usage: ./dot arch-check [--only step,...]' ;;
      *) die "Unknown option: $1. Usage: ./dot arch-check [--only step,...]" ;;
    esac
  done
  [[ -n ${only} ]] || die 'Usage: ./dot arch-check [--only step,...]'
  arch_load_modules
  require_arch_system
  local failed=0
  local steps_text steps_rc=0
  steps_text="$(arch_selected_steps "${only}")" || steps_rc=$?
  ((steps_rc == 0)) || die "Refusing to check with step filter '${only}' (see error above)."
  local -a steps=() step
  while IFS= read -r step; do
    [[ -n ${step} ]] || continue
    steps+=("${step}")
  done <<<"${steps_text}"
  ((${#steps[@]} > 0)) || die "Refusing an empty arch check with filter '${only}'."
  for step in "${steps[@]}"; do
    case "${step}" in
      system)
        arch_system_verify || failed=1
        # MEGA vendor repo status, read-only (a check never mutates). A
        # missing module or unconfigured repo pre-init is expected drift:
        # reported in place, repaired by the install paths, never here.
        if arch_source_mega_quiet; then
          if declare -F arch_mega_verify_vendor_repo >/dev/null 2>&1; then
            arch_mega_verify_vendor_repo || failed=1
          else
            log_error 'lib/arch-mega.sh does not provide arch_mega_verify_vendor_repo.'
            failed=1
          fi
        else
          log_info 'MEGA vendor module is missing: lib/arch-mega.sh has not landed; skipping repo verification.'
        fi
        ;;
      gpu) arch_gpu_verify || failed=1 ;;
      snapshots) arch_snapshots_verify || failed=1 ;;
      desktop)
        if ! arch_desktop_is_loaded && ! arch_source_desktop_quiet; then
          log_error 'Arch desktop module is missing: lib/arch-desktop.sh has not landed.'
          failed=1
        else
          arch_require_desktop_interface
          arch_desktop_verify_overlay || failed=1
          arch_desktop_verify_caelestia || failed=1
        fi
        ;;
      greeter) arch_greeter_verify || failed=1 ;;
      video) arch_video_verify || failed=1 ;;
      limine) arch_limine_verify || failed=1 ;;
    esac
  done
  ((failed == 0)) || die 'Arch check found the problems listed above.'
  log_ok 'Arch check passed: provisioning matches the repo.'
}

main() {
  local cmd=${1:-help}
  shift || true
  case "${cmd}" in
    init) detect_distro; cmd_init "$@" ;;
    update) detect_distro; cmd_update "$@" ;;
    nvidia) detect_distro; cmd_nvidia "$@" ;;
    stow) cmd_stow "$@" ;;
    doctor) detect_distro; cmd_doctor "$@" ;;
    check-packages) detect_distro; cmd_check_packages "$@" ;;
    package) detect_distro; cmd_package "$@" ;;
    benchmark-shell) cmd_benchmark_shell "$@" ;;
    arch-setup) detect_distro; cmd_arch_setup "$@" ;;
    arch-check) detect_distro; cmd_arch_check "$@" ;;
    help | -h | --help) usage ;;
    *) die "Unknown command: ${cmd}. See ./dot help." ;;
  esac
}

main "$@"
