#!/usr/bin/env bash
set -euo pipefail

# dot — the CLI entry point. Arch Linux and Fedora, opinionated, idempotent.
# `./dot help` lists the commands; README.md explains the layout,
# packages/<distro>.bundle holds the package list, and lib/arch-*.sh holds
# Arch system provisioning (sourced lazily, Arch commands only).

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly DOTFILES_DIR
readonly HOME_DIR="${DOTFILES_DIR}/home"
# Arch-only paths. home-arch/ and lib/arch-desktop.sh belong to the
# arch-design agent; dot references them but never creates them.
readonly ARCH_HOME_OVERLAY_DIR="${DOTFILES_DIR}/home-arch"
# Fedora-only desktop sources, owned by this repo like shared home/.
readonly FEDORA_HOME_OVERLAY_DIR="${DOTFILES_DIR}/home-fedora"
readonly ARCH_DESKTOP_MODULE="${DOTFILES_DIR}/lib/arch-desktop.sh"
# MEGA vendor-repo module. lib/arch-mega.sh belongs to the arch-apps
# agent; dot references its three-function API but never creates it.
readonly ARCH_MEGA_MODULE="${DOTFILES_DIR}/lib/arch-mega.sh"
readonly ARCH_LIB_DIR="${DOTFILES_DIR}/lib"
readonly APPIMAGE_DIR="${HOME}/Applications"
readonly DESKTOP_DIR="${HOME}/.local/share/applications"

# Set by detect_distro: arch or fedora.
DISTRO=''
BUNDLE_FILE=''

if [[ -t 1 ]]; then
  readonly C_RESET=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m'
  readonly C_CYAN=$'\e[1;36m' C_GREEN=$'\e[1;32m' C_YELLOW=$'\e[1;33m' C_RED=$'\e[1;31m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED=''
fi

log_step() { printf '\n%s[*]%s %s%s\n' "${C_CYAN}" "${C_RESET}" "${C_BOLD}" "$*${C_RESET}"; }
log_ok() { printf '%s[+]%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"; }
log_info() { printf '%s[i]%s %s\n' "${C_DIM}" "${C_RESET}" "$*"; }
log_warn() { printf '%s[!]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
log_error() { printf '%s[x]%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; }
die() { log_error "$*"; exit 1; }

usage() {
  cat <<'EOF'
dot — install packages and link dotfiles on Arch and Fedora.

  ./dot init             helpers, packages, herdr, stow, plugins, fish shell
  ./dot update           git pull --rebase, then everything init does
  ./dot nvidia           install the NVIDIA drivers if this machine has one (Fedora)
  ./dot stow             (re)link home/ into $HOME, overwriting conflicts
  ./dot doctor           check helpers, packages, plugins, symlinks, shell
  ./dot check-packages   list bundle entries missing from this machine
  ./dot package list     show this distro's bundle
  ./dot package add NAME|URL [--aur|--rpm|--flatpak|--repofile|--copr]
                             [--appimage|--npm|--npm-scripts]
  ./dot package remove NAME
  ./dot benchmark-shell [-r RUNS]   time fish startup
  ./dot arch-setup [--only step,...] [--replace-display-manager]
                             provision this Arch machine (Arch-only, idempotent repair)
  ./dot arch-check [--only step,...]
                             verify Arch provisioning without changing anything

Arch steps for --only: system gpu snapshots desktop greeter video limine.
On Arch, ./dot init links user files (shared plus overlay); ./dot arch-setup
provisions the system afterwards. Fedora has no arch commands.

The distro picks the bundle: packages/arch.bundle or packages/fedora.bundle.
Flags name the bundle verb; without one an entry is a repository package.
EOF
}

require_user() {
  ((EUID != 0)) || die 'Run ./dot as your regular user, not root. It calls sudo itself when needed.'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

# Temp file to clean up and the sudo refresher to stop when the script exits.
ELEVATION_PID=''
CLEANUP_PATH=''

cleanup_dot() {
  end_elevation
  [[ -n ${CLEANUP_PATH} ]] && rm -rf -- "${CLEANUP_PATH}"
  return 0
}
trap cleanup_dot EXIT

end_elevation() {
  [[ -n ${ELEVATION_PID} ]] || return 0
  # Kill the refresher's sleep child too: bash defers the signal until its
  # foreground child exits, which would keep the loop alive one more cycle.
  pkill -P "${ELEVATION_PID}" 2>/dev/null || true
  kill "${ELEVATION_PID}" 2>/dev/null || true
  wait "${ELEVATION_PID}" 2>/dev/null || true
  ELEVATION_PID=''
}

# Ask for the sudo password once, then keep the timestamp alive for the run.
begin_elevation() {
  require_command sudo
  log_info 'sudo will ask for your password once; it covers the whole run.'
  sudo -v || die 'sudo authentication failed.'
  # Refresh well inside sudo's 5-minute timestamp_timeout (man sudoers).
  (while sleep 120; do sudo -n -v 2>/dev/null || exit 0; done) >/dev/null 2>&1 &
  ELEVATION_PID=$!
}

# Pick this machine's bundle. Arch derivatives are accepted through ID_LIKE;
# anything that is neither Arch nor Fedora is rejected before any change.
detect_distro() {
  [[ -n ${DISTRO} ]] && return 0
  [[ -r /etc/os-release ]] || die '/etc/os-release not found; this repo supports Arch and Fedora.'
  local ids
  # os-release is a shell fragment by spec; read it in a subshell.
  # shellcheck source=/dev/null
  ids="$(. /etc/os-release && printf '%s %s' "${ID:-}" "${ID_LIKE:-}")"
  case " ${ids} " in
    *' arch '*) DISTRO=arch ;;
    *' fedora '*) DISTRO=fedora ;;
    *) die "Unsupported distro: ${ids:-unknown}. This repo supports Arch and Fedora." ;;
  esac
  BUNDLE_FILE="${DOTFILES_DIR}/packages/${DISTRO}.bundle"
}

# --- bundle -----------------------------------------------------------------

# Split one bundle line into ENTRY_VERB / ENTRY_NAME / ENTRY_URL. Returns 1
# for blank lines and comments. Accepts repo "foo", aur 'foo', repo foo, and
# the two-field forms rpm "name" "URL" / appimage "name" "URL", each with an
# optional trailing # comment. require_verb_for_distro validates the verb.
parse_bundle_line() {
  local line=${1%%#*} extra
  read -r ENTRY_VERB ENTRY_NAME ENTRY_URL extra <<<"${line}"
  [[ -n ${ENTRY_VERB} ]] || return 1
  ENTRY_NAME=${ENTRY_NAME#[\"\']}; ENTRY_NAME=${ENTRY_NAME%[\"\']}
  ENTRY_URL=${ENTRY_URL#[\"\']}; ENTRY_URL=${ENTRY_URL%[\"\']}
  [[ -n ${ENTRY_NAME} ]] || die "Bundle line has no package name: ${line}"
  [[ -z ${extra} ]] || die "Bundle line has trailing text: ${line}"
  # No dnf call can end its options with `--` (dnf5 dropped it), so a name or
  # URL that starts with a dash would reach it as an option. Nothing legitimate
  # does.
  [[ ${ENTRY_NAME} != -* && ${ENTRY_URL} != -* ]] || die "Bundle entry starts with a dash: ${line}"
  # rpm and appimage install from a pinned URL that does not reveal the
  # installed name, so they carry both; every other verb names its own thing.
  case "${ENTRY_VERB}" in
    rpm | appimage) [[ -n ${ENTRY_URL} ]] || die "${ENTRY_VERB} entries need a name and a URL: ${line}" ;;
    *) [[ -z ${ENTRY_URL} ]] || die "${ENTRY_VERB} entries take a single name: ${line}" ;;
  esac
  return 0
}

# Each bundle is an installation recipe for one distro: nothing is translated
# across distros, so a verb that cannot work here is a hard error.
require_verb_for_distro() {
  case "$1" in
    repo | aur | rpm | repofile | copr | flatpak | appimage | npm | npm-scripts) ;;
    *) die "Unknown bundle verb: $1" ;;
  esac
  case "${DISTRO}:$1" in
    arch:repo | arch:aur | arch:appimage | fedora:repo) return 0 ;;
    fedora:aur) die "Verb 'aur' is Arch-only. Give packages/fedora.bundle a verified Fedora source instead." ;;
    fedora:*) return 0 ;;
    *) die "Verb '$1' is Fedora-only. packages/arch.bundle takes repo, aur, or appimage." ;;
  esac
}

# Every entry of this distro's bundle, in file order, as "verb name [url]".
# Neither field contains whitespace, so `read -r verb name url` splits them.
BUNDLE_ENTRIES=()
parse_bundle() {
  BUNDLE_ENTRIES=()
  [[ -r ${BUNDLE_FILE} ]] || die "Missing bundle file: ${BUNDLE_FILE}"
  local line
  while IFS= read -r line || [[ -n ${line} ]]; do
    parse_bundle_line "${line}" || continue
    require_verb_for_distro "${ENTRY_VERB}"
    BUNDLE_ENTRIES+=("${ENTRY_VERB} ${ENTRY_NAME} ${ENTRY_URL}")
  done <"${BUNDLE_FILE}"
}

# The verb an entry is filed under, or nothing when the bundle lacks it.
bundle_verb_of() {
  local needle=$1 entry verb name
  for entry in "${BUNDLE_ENTRIES[@]}"; do
    read -r verb name _ <<<"${entry}"
    [[ ${name} == "${needle}" ]] || continue
    printf '%s\n' "${verb}"
    return 0
  done
  return 1
}

# --- packages ---------------------------------------------------------------

# An npm entry may pin a dist-tag (@scope/pkg@beta). Installing wants the whole
# spec; querying and removing want the name, and the @ that opens a scope is
# not a separator.
npm_entry_name() {
  if [[ ${1#@} == *@* ]]; then
    printf '%s\n' "${1%@*}"
  else
    printf '%s\n' "$1"
  fi
}

appimage_path() { printf '%s/%s\n' "${APPIMAGE_DIR}" "$(basename -- "$1")"; }

appimage_desktop() {
  printf '%s/appimage-%s.desktop\n' "${DESKTOP_DIR}" "$(tr '[:upper:]' '[:lower:]' <<<"$1")"
}

# App name to default to when `dot package add` is given only a URL:
# Obsidian-1.13.7.AppImage -> Obsidian. The bundle records it explicitly, so a
# bad guess is one word to fix by hand.
appimage_app() {
  local file
  file="$(basename -- "$1")"
  file=${file%.AppImage}
  printf '%s\n' "${file%%-[0-9]*}"
}

# Download an AppImage into ~/Applications (no root) and generate a desktop
# entry so it is launchable without AppImageLauncher. The icon is left to the
# app itself. The file keeps the pinned URL's name, so bumping the URL
# reinstalls and sweeps the previous build.
appimage_install() {
  local name=$1 url=$2 target tmp old
  require_command curl
  target="$(appimage_path "${url}")"
  mkdir -p -- "${APPIMAGE_DIR}" "${DESKTOP_DIR}"
  if [[ -x ${target} ]]; then
    log_ok "${name} is already installed: ${target}"
  else
    tmp="$(mktemp "${APPIMAGE_DIR}/.${name}.XXXXXX")" || die "Cannot write to ${APPIMAGE_DIR}."
    CLEANUP_PATH=${tmp}
    log_info "Downloading ${url}"
    curl -fL --progress-bar --retry 3 -o "${tmp}" "${url}" || die "Failed to download ${url}"
    chmod 755 -- "${tmp}"
    for old in "${APPIMAGE_DIR}/${name}.AppImage" "${APPIMAGE_DIR}/${name}"-*.AppImage; do
      if [[ -f ${old} && ${old} != "${target}" ]]; then
        log_info "Removing the previous build: ${old##*/}"
        rm -f -- "${old}"
      fi
    done
    mv -- "${tmp}" "${target}"
    CLEANUP_PATH=''
    log_ok "${name} installed: ${target}"
  fi
  # Rewritten every run: a deleted launcher would otherwise never come back.
  cat >"$(appimage_desktop "${name}")" <<EOF
[Desktop Entry]
Type=Application
Name=${name}
Exec=${target}
Terminal=false
EOF
}

# The version-release the build at an rpm URL serves, read out of the package
# header. The header sits at the front of the file, so a short ranged
# download answers without fetching the whole (100MB+) package; 2MB covers
# even the chatgpt RPM's oversized header. No output means the URL is
# unreadable (offline, CDN without range support) and callers fall back.
rpm_url_evr() {
  local url=$1 tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/rpm-url-evr.XXXXXX")" || return 1
  curl -fsL --range 0-2097151 --max-filesize 4194304 --retry 3 -o "${tmp}" "${url}" \
    || { rm -f -- "${tmp}"; return 1; }
  rpm -qp --qf '%{VERSION}-%{RELEASE}' -- "${tmp}" 2>/dev/null
  local rc=$?
  rm -f -- "${tmp}"
  ((rc == 0)) || return 1
}

# Is this entry installed? repofile and copr configure sources rather than
# install anything, so they report installed and are skipped by the checks.
pkg_query() {
  local verb=$1 name=$2 url=${3:-} listed
  case "${verb}" in
    repofile | copr) return 0 ;;
    repo | aur | rpm)
      case "${DISTRO}" in
        arch) pacman -Q -- "${name}" >/dev/null 2>&1 ;;
        fedora) rpm -q -- "${name}" >/dev/null 2>&1 ;;
      esac
      ;;
    appimage) [[ -x "$(appimage_path "${url}")" ]] ;;
    flatpak)
      command -v flatpak >/dev/null 2>&1 || return 1
      flatpak info "${name}" >/dev/null 2>&1
      ;;
    npm | npm-scripts)
      # Capture before matching: `npm ls -g` exits non-zero over any extraneous
      # or unmet dependency, and pipefail would read that as "not installed".
      command -v npm >/dev/null 2>&1 || return 1
      listed="$(npm ls -g --depth=0 2>/dev/null || true)"
      grep -Fq -- "$(npm_entry_name "${name}")@" <<<"${listed}"
      ;;
  esac
}

# Install one entry. Batched installs live in install_packages; this is the
# single-entry path, shared by `dot package add`.
# dnf5 rejects the `--` end-of-options separator, so no dnf call carries one;
# a name that could pass for an option is refused when the entry is read.
pkg_install() {
  local verb=$1 name=$2 url=${3:-}
  case "${verb}" in
    repo)
      case "${DISTRO}" in
        arch) sudo pacman -Syu --needed --noconfirm -- "${name}" ;;
        fedora) sudo dnf install -y "${name}" ;;
      esac
      ;;
    aur)
      require_command yay
      log_warn 'AUR PKGBUILDs are user-produced. Review the changes shown by yay before approving.'
      yay -S --aur --needed -- "${name}"
      ;;
    rpm)
      # dnf has to download the package before it can tell the pinned build is
      # already installed, and these are 100MB+ each, so ask rpm first. When
      # the name is installed, compare its version-release against the build
      # the URL serves: that is what lets a bumped URL, or a rolling "latest"
      # one, update on the next run instead of skipping forever.
      if pkg_query rpm "${name}"; then
        local installed_evr url_evr
        installed_evr="$(rpm -q --qf '%{VERSION}-%{RELEASE}' -- "${name}")"
        url_evr="$(rpm_url_evr "${url}")" || url_evr=''
        if [[ -z ${url_evr} ]]; then
          log_info "Cannot read the build ${url} serves; leaving installed ${name}-${installed_evr} alone."
          return 0
        fi
        # rpm's own comparator: -1 the URL is older, 0 equal, 1 newer.
        case "$(rpm --eval "%{lua: print(rpm.vercmp('${url_evr}', '${installed_evr}'))}")" in
          1) log_info "${name}: ${url##*/} is newer than the installed ${installed_evr}." ;;
          *)
            log_info "${name} ${installed_evr} is already the build ${url} serves."
            return 0
            ;;
        esac
      fi
      sudo dnf install -y "${url}"
      ;;
    repofile) sudo dnf config-manager addrepo --from-repofile="${name}" --overwrite ;;
    copr) sudo dnf -y copr enable "${name}" ;;
    flatpak)
      require_command flatpak
      # Flathub is the only remote these entries come from, and both commands
      # are system-wide: a per-user install would not follow a second user in.
      sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
      sudo flatpak install -y flathub "${name}"
      ;;
    npm)
      # --ignore-scripts is pi's documented supply-chain posture; it applies
      # to every npm entry. The npm-scripts verb below is the one exemption.
      require_command npm
      sudo npm install -g --ignore-scripts "${name}"
      ;;
    npm-scripts)
      # A package whose postinstall does the actual install — it fetches the
      # platform binary, and --ignore-scripts leaves a stub that dies on first
      # run. Filed under its own verb so the exemption is one grep away.
      require_command npm
      log_warn "Running ${name}'s own install scripts as root: this entry is exempt from --ignore-scripts."
      sudo npm install -g "${name}"
      ;;
    appimage) appimage_install "${name}" "${url}" ;;
  esac
}

# Uninstall one entry. Failures are warnings: a package may be gone already,
# or kept as a dependency.
pkg_remove() {
  local verb=$1 name=$2 url=${3:-}
  case "${verb}" in
    repo)
      case "${DISTRO}" in
        arch) sudo pacman -Rns --noconfirm -- "${name}" || log_warn "pacman could not remove ${name}." ;;
        fedora) sudo dnf remove -y "${name}" || log_warn "dnf could not remove ${name}." ;;
      esac
      ;;
    aur) yay -Rns --noconfirm -- "${name}" || log_warn "yay could not remove ${name}." ;;
    rpm) sudo dnf remove -y "${name}" || log_warn "dnf could not remove ${name}." ;;
    flatpak) sudo flatpak uninstall -y "${name}" || log_warn "flatpak could not remove ${name}." ;;
    npm | npm-scripts) sudo npm uninstall -g "$(npm_entry_name "${name}")" || log_warn "npm could not remove ${name}." ;;
    appimage) rm -f -- "$(appimage_path "${url}")" "$(appimage_desktop "${name}")" ;;
    repofile) log_warn "The repository from ${name} stays configured; drop its file from /etc/yum.repos.d if unwanted." ;;
    copr) log_warn "The COPR stays enabled; run: sudo dnf copr disable ${name}" ;;
  esac
}

ensure_helpers() {
  case "${DISTRO}" in
    arch)
      if ! command -v yay >/dev/null 2>&1; then
        # Bootstrap the AUR helper as a regular user.
        require_command git
        log_step 'Bootstrapping yay-bin from the AUR'
        sudo pacman -Syu --needed --noconfirm base-devel git
        require_command makepkg
        local tmpdir
        tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/yay-bin.XXXXXX")" || die 'Failed to create temp dir for yay bootstrap.'
        CLEANUP_PATH=${tmpdir}
        git clone --depth 1 https://aur.archlinux.org/yay-bin.git "${tmpdir}" \
          || die 'Failed to clone yay-bin from the AUR (network or AUR unreachable).'
        (cd -- "${tmpdir}" && makepkg -si --noconfirm) || die 'Failed to build and install yay-bin.'
        rm -rf -- "${tmpdir}"
        CLEANUP_PATH=''
        require_command yay
        log_ok 'yay installed.'
      fi
      command -v stow >/dev/null 2>&1 || sudo pacman -Syu --needed --noconfirm stow
      ;;
    fedora)
      require_command dnf
      local -a missing=()
      command -v stow >/dev/null 2>&1 || missing+=(stow)
      # config-manager and copr plugins, used by the repofile and copr verbs.
      rpm -q dnf5-plugins >/dev/null 2>&1 || missing+=(dnf5-plugins)
      if ((${#missing[@]} > 0)); then
        log_step "Installing Fedora helpers: ${missing[*]}"
        sudo dnf install -y "${missing[@]}"
      fi
      ;;
  esac
}

install_packages() {
  # Validate first: a malformed or unsupported bundle dies here, before any
  # vendor key is trusted or pacman.conf edited.
  parse_bundle
  # MEGA vendor repo only on demand: when the parsed bundle actually
  # requests a vendor package. init, update, and arch-setup all batch
  # through here, so one conditional covers every bundle install. Runs
  # under the caller's elevation; Arch-gated inside the ensure.
  if bundle_requests_mega_repo; then
    ensure_mega_vendor_repo
  fi
  local entry verb name url
  local -a repo_pkgs=() aur_pkgs=()
  # Sources first: repofile and copr entries feed the repo entries below them.
  for entry in "${BUNDLE_ENTRIES[@]}"; do
    read -r verb name url <<<"${entry}"
    case "${verb}" in
      repo) repo_pkgs+=("${name}") ;;
      aur) aur_pkgs+=("${name}") ;;
      repofile | copr)
        log_step "Configuring ${verb} ${name}"
        pkg_install "${verb}" "${name}"
        ;;
    esac
  done
  # One batched transaction per package manager (and one yay review prompt).
  # -Syu, not -S: Arch does not support installing into a partially upgraded
  # system, so a repo install upgrades it.
  if ((${#repo_pkgs[@]} > 0)); then
    log_step "Installing ${#repo_pkgs[@]} repo package(s)"
    case "${DISTRO}" in
      arch) sudo pacman -Syu --needed --noconfirm "${repo_pkgs[@]}" ;;
      fedora) sudo dnf install -y "${repo_pkgs[@]}" ;;
    esac
  fi
  if ((${#aur_pkgs[@]} > 0)); then
    require_command yay
    log_step "Installing ${#aur_pkgs[@]} AUR package(s)"
    log_warn 'AUR PKGBUILDs are user-produced. Review the changes shown by yay before approving.'
    yay -S --aur --needed "${aur_pkgs[@]}"
  fi
  # Everything else installs one entry at a time, in bundle order.
  for entry in "${BUNDLE_ENTRIES[@]}"; do
    read -r verb name url <<<"${entry}"
    case "${verb}" in
      repo | aur | repofile | copr) continue ;;
    esac
    log_step "Installing ${verb} ${name}"
    pkg_install "${verb}" "${name}" "${url}"
  done
  log_ok 'Packages installed.'
}

# Install a tool from its vendor's own install script when missing. Used for
# tools whose packaged routes are deprecated or absent.
ensure_upstream() {
  local cmd=$1 url=$2 tmp found
  export PATH="${HOME}/.local/bin:${PATH}"
  if found="$(command -v "${cmd}" 2>/dev/null)"; then
    log_ok "${cmd} already installed: ${found}"
    return 0
  fi
  require_command curl
  log_step "Installing ${cmd} via its official installer (${url})"
  tmp="$(mktemp "${TMPDIR:-/tmp}/${cmd}-install.XXXXXX.sh")" || die "Failed to create a temp file for the ${cmd} installer."
  CLEANUP_PATH=${tmp}
  curl -fsSL --retry 3 "${url}" -o "${tmp}" || die "Failed to download ${url}"
  sh "${tmp}" || die "The ${cmd} installer failed."
  rm -f -- "${tmp}"
  CLEANUP_PATH=''
  hash -r 2>/dev/null || true
  found="$(command -v "${cmd}" 2>/dev/null)" || die "The ${cmd} installer finished but no ${cmd} binary was found."
  log_ok "${cmd} installed: ${found}"
}

install_tools() {
  # Claude Code: npm installs are deprecated upstream. On Arch the bundle's
  # AUR package already provides it.
  if [[ ${DISTRO} == fedora ]]; then
    ensure_upstream claude https://claude.ai/install.sh
  fi
  ensure_upstream herdr https://herdr.dev/install.sh
}

# --- nvidia -----------------------------------------------------------------

# The entire detection: does lspci list a PCI device from NVIDIA (vendor
# 10de)? It answers in milliseconds, and a missing lspci or an empty list
# means there is nothing to do.
has_nvidia_gpu() {
  command -v lspci >/dev/null 2>&1 || return 1
  lspci -d 10de: 2>/dev/null | grep -q .
}

# The proprietary NVIDIA drivers, following
# https://docs.fedoraproject.org/en-US/gaming/drivers/ to the letter: a full
# system upgrade first, then rpm Fusion's free and nonfree release packages,
# then akmod-nvidia. Fedora only, and a no-op without NVIDIA hardware, so
# machines with other GPUs pay for one lspci call.
ensure_nvidia() {
  [[ ${DISTRO} == fedora ]] || return 0
  has_nvidia_gpu || return 0
  if command -v nvidia-smi >/dev/null 2>&1 || rpm -q akmod-nvidia >/dev/null 2>&1; then
    log_ok 'NVIDIA drivers already installed.'
    return 0
  fi
  log_step 'NVIDIA GPU found; installing the proprietary drivers per docs.fedoraproject.org/en-US/gaming/drivers/'
  # Upgrade before the driver: on a fresh install the kernel and its headers
  # lag the repos, and akmod-nvidia would build against that stale kernel and
  # come up incomplete. (dnf update and upgrade are the same operation, so one
  # run covers both.)
  sudo dnf upgrade -y
  sudo dnf install -y \
    "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"
  sudo dnf install -y akmod-nvidia
  # The docs warn that the driver builds after install: akmod-nvidia compiles
  # the kernel module in the background, and a reboot mid-build loads none.
  log_warn 'The NVIDIA kernel module is still building. Give it a few minutes (check: modinfo nvidia), then reboot to load the driver.'
}

cmd_nvidia() {
  [[ ${DISTRO} == fedora ]] || die 'NVIDIA handling is Fedora-only.'
  require_user
  if ! has_nvidia_gpu; then
    log_ok 'No NVIDIA GPU detected; nothing to do.'
    return 0
  fi
  begin_elevation
  ensure_nvidia
}

# --- dotfiles ---------------------------------------------------------------

# Every file and symlink under home/, NUL-separated, in stable order.
# node_modules (npm workspaces) and home/.pi/.gitignore stay in the repo.
home_files() {
  find "${HOME_DIR}" -mindepth 1 \( -name node_modules -o -name .gitignore \) -prune \
    -o \( -type f -o -type l \) -print0 | sort -z
}

# Repo forwarding aliases kept where Fedora-owned files used to live, so
# links stowed before the move keep resolving through them. Transitional,
# not configuration: shared stow and doctor skip them on every distro, and
# each distro stows its own real copy from its own tree instead.
HOME_COMPAT_FORWARD_PATHS=(
  .config/ghostty/config
  .config/hypr/input.lua
)

# True when a shared-home relpath is a forwarding alias. Distro-independent
# and unset-safe: shared stow and doctor skip these everywhere.
home_path_is_compat_forward() {
  local path=$1 candidate
  for candidate in ${HOME_COMPAT_FORWARD_PATHS[@]+"${HOME_COMPAT_FORWARD_PATHS[@]}"}; do
    [[ ${path} == "${candidate}" ]] && return 0
  done
  return 1
}

# One stow --ignore flag per forwarding alias, derived from the list above
# so the selection lives in exactly one place (dots are the only regex
# metacharacters these paths contain).
home_compat_ignore_pattern() {
  printf -- '--ignore=(^|/)%s$\n' "${1//./\\.}"
}

stow_dotfiles() {
  require_command stow
  [[ -d ${HOME_DIR} ]] || die "Missing home directory: ${HOME_DIR}"
  log_step "Linking home/ into ${HOME} (conflicts are overwritten, no backup)"
  local src rel target compat
  while IFS= read -r -d '' src; do
    rel=${src#"${HOME_DIR}/"}
    # Forwarding aliases are never stowed from shared home/; each distro
    # stows its own real copy from its own tree instead.
    home_path_is_compat_forward "${rel}" && continue
    target="${HOME}/${rel}"
    [[ -e ${target} || -L ${target} ]] || continue
    # find yields files and symlinks only, so a real directory here is a
    # collision stow could never resolve. Fail loudly rather than delete it.
    [[ -d ${target} && ! -L ${target} ]] && die "Cannot stow ${rel}: ${target} is a directory."
    [[ "$(realpath -m -- "${target}")" == "$(realpath -m -- "${src}")" ]] && continue
    log_info "Overwriting ${target}"
    rm -f -- "${target}"
  done < <(home_files)
  local -a stow_ignores=(--ignore='(^|/)node_modules(/|$)')
  for compat in ${HOME_COMPAT_FORWARD_PATHS[@]+"${HOME_COMPAT_FORWARD_PATHS[@]}"}; do
    stow_ignores+=("$(home_compat_ignore_pattern "${compat}")")
  done
  stow -R --no-folding "${stow_ignores[@]}" -d "${DOTFILES_DIR}" -t "${HOME}" home
  log_ok 'Dotfiles stowed.'
}

# Every file and symlink under home-arch/, NUL-separated, in stable order.
arch_overlay_files() {
  find "${ARCH_HOME_OVERLAY_DIR}" -mindepth 1 \( -name node_modules -o -name .gitignore \) -prune \
    -o \( -type f -o -type l \) -print0 | sort -z
}

# Every file and symlink under home-fedora/, NUL-separated, in stable order.
# The optional dir is a test seam for the real-files refusal; production
# always passes the default.
fedora_overlay_files() {
  local overlay_dir=${1:-$FEDORA_HOME_OVERLAY_DIR}
  find "${overlay_dir}" -mindepth 1 \( -name node_modules -o -name .gitignore \) -prune \
    -o \( -type f -o -type l \) -print0 | sort -z
}

# Link the Fedora overlay after shared stow. Self-gated (unset returns
# silently) and caller-gated: single-valued DISTRO runs exactly one overlay.
# Warns (not dies) without the tree so plain stow stays usable;
# provisioning fails loudly through arch-check instead.
# No backup logic: same overwrite/no-backup contract as shared stow.
stow_fedora_overlay() {
  [[ ${DISTRO:-} == fedora ]] || return 0
  local overlay_dir=${1:-$FEDORA_HOME_OVERLAY_DIR}
  [[ -d ${overlay_dir} ]] || { log_warn 'home-fedora/ is missing; skipping the Fedora overlay.'; return 0; }
  require_command stow
  # The Fedora source tree must hold real files only: a symlink or special
  # entry would hide indirection in a deployed link, so refuse naming it.
  local stray
  stray="$(find "${overlay_dir}" -mindepth 1 ! -type d ! -type f -print -quit 2>/dev/null || true)"
  [[ -z ${stray} ]] || die "home-fedora/ must hold real files only; refusing: ${stray}"
  log_step "Linking home-fedora/ into ${HOME} (conflicts are overwritten, no backup)"
  local src rel target
  while IFS= read -r -d '' src; do
    rel=${src#"${overlay_dir}/"}
    target="${HOME}/${rel}"
    [[ -e ${target} || -L ${target} ]] || continue
    [[ -d ${target} && ! -L ${target} ]] && die "Cannot stow ${rel}: ${target} is a directory."
    # Reclaim every symlink, even a same-content chain through an old path:
    # stow only accepts links it wrote itself and aborts the whole package
    # on foreign ones, so canonical equality is not enough to leave one.
    if [[ ! -L ${target} && "$(realpath -m -- "${target}")" == "$(realpath -m -- "${src}")" ]]; then
      continue
    fi
    log_info "Overwriting ${target}"
    rm -f -- "${target}"
  done < <(fedora_overlay_files "${overlay_dir}")
  stow -R --no-folding --ignore='(^|/)node_modules(/|$)' -d "$(dirname -- "${overlay_dir}")" -t "${HOME}" "$(basename -- "${overlay_dir}")"
  log_ok 'Fedora overlay stowed.'
}

# Link the Arch overlay after shared stow, so known overrides (Ghostty) win.
# Self-gated (unset returns silently) and caller-gated: single-valued
# DISTRO runs exactly one overlay. Warns (not dies) without the overlay so
# plain stow stays usable before home-arch/ lands; arch-setup itself fails
# loudly instead (see arch_load_desktop_or_die).
# No backup logic: same overwrite/no-backup contract as shared stow.
# Compositor-owned user files are NOT stowed here: the desktop module owns
# them (arch_desktop_deployed_relpaths), and this function lazy-sources it
# and calls arch_desktop_deploy_user_files, never reimplementing the
# deploy. The stow --ignore literal below must stay identical to
# arch_desktop_install_overlay in lib/arch-desktop.sh.
stow_arch_overlay() {
  [[ ${DISTRO:-} == arch ]] || return 0
  [[ -d ${ARCH_HOME_OVERLAY_DIR} ]] || { log_warn 'home-arch/ has not landed yet; skipping the Arch overlay.'; return 0; }
  arch_source_desktop_quiet \
    || die 'lib/arch-desktop.sh is missing but home-arch/ is present; refusing a half-managed stow.'
  declare -F arch_desktop_is_deployed_file >/dev/null 2>&1 \
    || die 'lib/arch-desktop.sh does not provide arch_desktop_is_deployed_file; coordinate the API before proceeding.'
  declare -F arch_desktop_deploy_user_files >/dev/null 2>&1 \
    || die 'lib/arch-desktop.sh does not provide arch_desktop_deploy_user_files; coordinate the API before proceeding.'
  require_command stow
  log_step "Linking home-arch/ into ${HOME} (conflicts are overwritten, no backup)"
  local src rel target
  while IFS= read -r -d '' src; do
    rel=${src#"${ARCH_HOME_OVERLAY_DIR}/"}
    # Deployed user files are owned by the desktop module's deploy step
    # below: never pre-clean them (a live compositor recreates a missing
    # path within milliseconds, which is exactly the race that aborts stow).
    arch_desktop_is_deployed_file "${rel}" && continue
    target="${HOME}/${rel}"
    [[ -e ${target} || -L ${target} ]] || continue
    [[ -d ${target} && ! -L ${target} ]] && die "Cannot stow ${rel}: ${target} is a directory."
    # Same symlink reclaim as the Fedora overlay: stow aborts on any link
    # it did not write itself, including same-content pre-move chains.
    if [[ ! -L ${target} && "$(realpath -m -- "${target}")" == "$(realpath -m -- "${src}")" ]]; then
      continue
    fi
    log_info "Overwriting ${target}"
    rm -f -- "${target}"
  done < <(arch_overlay_files)
  stow -R --no-folding --ignore='(^|/)node_modules(/|$)' \
    --ignore='(^|/)\.config/caelestia/hypr-(user|vars)\.lua$' \
    -d "${DOTFILES_DIR}" -t "${HOME}" home-arch
  arch_desktop_deploy_user_files
  arch_prune_stale_shared_links
  log_ok 'Arch overlay stowed.'
}

# Remove stale shared symlinks the Arch selection retired (the excluded hypr
# input: the overlay never provides it). Only a symlink resolving into shared
# home/ is provably ours, left by an earlier shared stow; real files and
# foreign links are warned about and left alone, since the overwrite rule no
# longer claims these paths.
arch_prune_stale_shared_links() {
  # Self-gated, not just caller-gated: Fedora must never reach the loop
  # body no matter who calls this helper.
  [[ ${DISTRO:-} == arch ]] || return 0
  local rel target
  for rel in ${HOME_COMPAT_FORWARD_PATHS[@]+"${HOME_COMPAT_FORWARD_PATHS[@]}"}; do
    # Overlay-provided paths were already reclaimed by the overlay sweep above.
    [[ -e ${ARCH_HOME_OVERLAY_DIR}/${rel} || -L ${ARCH_HOME_OVERLAY_DIR}/${rel} ]] && continue
    target="${HOME}/${rel}"
    [[ -e ${target} || -L ${target} ]] || continue
    if [[ -L ${target} && "$(realpath -m -- "${target}")" == "$(realpath -m -- "${HOME_DIR}/${rel}")" ]]; then
      log_info "Removing retired shared link ${target}"
      rm -f -- "${target}"
    else
      log_warn "${target} is no longer managed on Arch; leaving it alone."
    fi
  done
}

# Herdr plugins are listed one `owner/repo` per line, comments allowed.
herdr_plugins() {
  local plugin_file="${HOME_DIR}/.config/herdr/plugins.txt" line
  [[ -r ${plugin_file} ]] || die "Missing Herdr plugin list: ${plugin_file}"
  while IFS= read -r line || [[ -n ${line} ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z ${line} || ${line} == \#* ]] && continue
    printf '%s\n' "${line}"
  done <"${plugin_file}"
}

sync_herdr_plugins() {
  require_command herdr
  log_step 'Syncing Herdr plugins'
  # Command substitution, not <(...): a die inside a process substitution
  # would only kill the subshell and leave the sync looking successful.
  local plugins plugin failures=()
  plugins="$(herdr_plugins)"
  while IFS= read -r plugin; do
    [[ -n ${plugin} ]] || continue
    log_info "Syncing ${plugin}"
    herdr plugin install "${plugin}" --yes || failures+=("${plugin}")
  done <<<"${plugins}"
  ((${#failures[@]} == 0)) || die "Failed to sync Herdr plugin(s): ${failures[*]}"
  if herdr status server >/dev/null 2>&1; then
    herdr server reload-config >/dev/null \
      || log_warn 'Plugins synced, but the live server reload failed; restart herdr to pick them up.'
  fi
  log_ok 'Herdr plugins are up to date.'
}

fish_path() {
  command -v fish 2>/dev/null || die 'fish is not installed. Run ./dot init to install the bundle first.'
}

set_fish_shell() {
  local shell user current
  shell="$(fish_path)"
  grep -Fxq "${shell}" /etc/shells \
    || log_warn "${shell} is not listed in /etc/shells; some tools may refuse it."
  user="$(id -un)"
  current="$(getent passwd "${user}" | cut -d: -f7)"
  if [[ ${current} == "${shell}" ]]; then
    log_ok "fish is already the login shell for ${user}."
    return 0
  fi
  log_step "Setting fish as the login shell for ${user}"
  # usermod, not chsh: Fedora ships chsh in util-linux-user, which is not
  # installed by default and no longer exists in current releases. usermod
  # comes from shadow (Arch) / shadow-utils (Fedora), which are always there.
  sudo usermod -s "${shell}" "${user}"
  log_warn "Login shell changed to ${shell}. It takes effect at the next login."
}

