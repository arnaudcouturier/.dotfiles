{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/save-md",
    "agent/extensions/pi-skill-toggle",
    "agent/extensions/pi-worktrees"
  ],
  "scripts": {
    "check": "npm run check --workspace=pi-save-md-extension && npm run check --workspace=pi-worktrees-extension && npm run typecheck --workspace=pi-skill-toggle && npm run test --workspace=pi-skill-toggle",
    "test:save-md": "npm run test --workspace=pi-save-md-extension",
    "test:continue-after-compaction": "node --import tsx --test agent/extensions/tests/continue-after-compaction.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1"
  }
}
