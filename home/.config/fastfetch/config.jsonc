{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#e6b450",
      "2": "#aad94c"
    }
  },
  "display": {
    "separator": "  ",
    "constants": [
      "\u001b[37m",
      "\u001b[90m",
      "\u001b[90m",
      "\u001b[90m"
    ],
    "color": {
      "keys": "#e6b450",
      "title": "#aad94c"
    },
    "percent": {
      "color": {
        "green": "#39bae6",
        "yellow": "#efcf8f",
        "red": "#d95757"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭─────────────────────────────────────────╮"
    },
    {
      "type": "kernel",
      "key": "│ {$2}{$1}  kernel",
      "format": "{$2}{release>28}{$1} │"
    },
    {
      "type": "command",
      "key": "│   uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{>28} │"
    },
    {
      "type": "shell",
      "key": "│ {$2}{$1}  shell ",
      "format": "{$2}{pretty-name>28}{$1} │"
    },
    {
      "type": "command",
      "key": "│ {$3}{$1}  mem   ",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{$3}{>28}{$1} │"
    },
    {
      "type": "packages",
      "key": "│   pkgs  ",
      "format": "{all>28} │"
    },
    {
      "type": "command",
      "key": "│ {$2}{$1}  user  ",
      "text": "echo $USER",
      "format": "{$2}{>28}{$1} │"
    },
    {
      "type": "command",
      "key": "│   hname ",
      "text": "hostnamectl hostname",
      "format": "{>28} │"
    },
    {
      "type": "os",
      "key": "│ {$4}󰻀{$1}  distro",
      "format": "{$4}{name} {version}{$1} │"
    },
    {
      "type": "custom",
      "key": "╰─────────────────────────────────────────╯"
    },
    "break"
  ]
}
