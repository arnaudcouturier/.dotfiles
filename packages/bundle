# Arch package bundle.
#
# One entry per line:
#   repo "name"   # official Arch repositories, installed with pacman
#   aur "name"    # AUR, installed with yay (bootstrapped by `dot init` if missing)
#
# Trailing comments are allowed. `dot package add/remove` edits this file.

# Shell toolchain (fish is also set as the login shell by `dot init`)
repo "fish" # friendly interactive shell
repo "starship" # prompt
repo "eza" # modern ls replacement
repo "zoxide" # smarter cd
repo "fzf" # fuzzy finder
repo "fd" # modern find replacement used by fzf
repo "ripgrep" # fast code search
repo "bat" # cat with syntax highlighting
repo "direnv" # per-directory env (hooked in fish config, idle without .envrc)

# System plumbing for stow-based dotfiles
repo "stow" # GNU Stow, deploys home/ via symlinks
repo "shellcheck" # linter for this repo's dot script
repo "base-devel" # build toolchain for AUR packages (makepkg); no-op if present
repo "fastfetch" # minimalist system info shown in fish greeting (no logo)

# Herdr is installed separately by `dot` using its upstream installer.

# AI agent (prebuilt binary, no source build)
aur "pi-coding-agent-bin" # pi coding agent CLI

# Applications from the official repositories
repo "github-cli" # GitHub CLI
repo "obsidian" # Obsidian notes
repo "qbittorrent" # BitTorrent client
repo "mullvad-vpn" # Mullvad VPN client
repo "nextcloud-client" # Nextcloud desktop file-sync client
repo "tailscale" # mesh VPN

# AI agent CLIs
repo "openai-codex" # OpenAI Codex CLI (official extra repository)
aur "claude-code" # Anthropic's Claude Code agent CLI

# AUR applications
# proton-mail builds WebClients from source and its sharp dependency fails
# under yarn's node-gyp, so the -bin repack of Proton's official build is used.
aur "brave-origin-bin" # Brave Origin browser, the system's Chromium-based browser
aur "keeper-password-manager" # Keeper password manager
aur "proton-mail-bin" # Proton Mail and Proton Calendar desktop client
aur "equibop" # Equibop Discord client
aur "chatgpt-desktop" # ChatGPT desktop app (repack of the official Linux binary)
