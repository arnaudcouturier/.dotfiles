# Fedora packages. `dot package add/remove` edits this file; the trailing
# comment on each line says why the entry is there.
#
#   repo "name"            dnf, from Fedora's repos or one added below
#   repofile "URL"         vendor repository file
#   copr "owner/project"   COPR repository
#   rpm "name" "URL"       pinned official RPM (the URL hides the real name)
#   flatpak "app.id"       Flathub app, installed system-wide
#   appimage "Name" "URL"  pinned AppImage into ~/Applications
#   npm "package"          global npm package (--ignore-scripts)
#   npm-scripts "package"  global npm package whose postinstall must run
#
# Sources are configured before any package installs, so keep each repofile and
# copr next to what it feeds. Prefer the route that brings updates. Flatpak is
# for vendor-verified Flathub builds only, no names are translated from
# arch.bundle, and `aur` is refused here.
# Shell toolchain (dot init also makes fish the login shell)
repo "fish" # friendly interactive shell
copr "atim/starship" # the COPR starship's own README points Fedora users to
repo "starship" # prompt (Fedora retired its rust-starship package)
repo "eza" # modern ls replacement
repo "zoxide" # smarter cd
repo "fzf" # fuzzy finder
repo "fd-find" # modern find replacement used by fzf (binary is /usr/bin/fd)
repo "ripgrep" # fast code search
repo "bat" # cat with syntax highlighting
repo "direnv" # per-directory env (hooked in fish config, idle without .envrc)

# Plumbing for these dotfiles
repo "stow" # GNU Stow, deploys home/ via symlinks
repo "ShellCheck" # linter for the dot script (capitalized on Fedora)
repo "dnf5-plugins" # config-manager and copr plugins used by the verbs above
repo "fastfetch" # minimalist system info
# No base-devel equivalent: Fedora has no AUR and nothing here builds from source.

# Applications from the Fedora repositories
repo "gh" # GitHub CLI (Arch name: github-cli)
repo "neovim" # Neovim editor (the LazyVim starter config lives in home/.config/nvim)
repo "qbittorrent" # BitTorrent client
repo "nextcloud-client" # Nextcloud desktop file-sync client
repo "wl-clipboard" # clipboard for Herdr Annotate's copy actions (wl-copy/wl-paste on Wayland)

# Applications from official vendor repositories
repofile "https://pkgs.tailscale.com/stable/fedora/tailscale.repo" # Tailscale's official repo
repo "tailscale" # mesh VPN
repofile "https://repository.mullvad.net/rpm/stable/mullvad.repo" # Mullvad's official repo
repo "mullvad-vpn" # Mullvad VPN client
repofile "https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo" # Brave's official repo
repo "brave-origin" # Brave Origin, the system's Chromium-based browser

# Pinned official downloads; dot reads each URL's build out of the package
# header and compares it against the installed one on every run, so a bumped
# URL — or a rolling "latest" one — updates on the next ./dot update
rpm "keeperpasswordmanager" "https://download.keepersecurity.com/desktop_electron/Linux/repo/rpm/keeperpasswordmanager-18.6.1-1.x86_64.rpm" # Keeper password manager (vendor RPM repo ships no .repo file)
rpm "proton-mail" "https://proton.me/download/mail/linux/1.13.4/ProtonMail-desktop-beta.rpm" # Proton Mail and Calendar (stable channel; the file name says beta, the channel does not)
rpm "equibop" "https://github.com/Equicord/Equibop/releases/download/v3.3.0/equibop-3.3.0.x86_64.rpm" # Equibop Discord client, from the Equicord project's own release
rpm "chatgpt" "https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.x86_64.rpm" # ChatGPT desktop, OpenAI's own RPM — a rolling "latest" build whose %post also sets up OpenAI's official repo, so later updates flow through dnf

# Flathub — vendor-verified builds that update through flatpak
repo "flatpak" # the flatpak client itself (Workstation ships it; a fresh install may not)
flatpak "md.obsidian.Obsidian" # Obsidian notes (Flathub build, verified by the Obsidian team)
flatpak "com.spotify.Client" # Spotify (Flathub build, verified by Spotify)

# AI agent CLIs
repo "nodejs22-bin" # Node.js runtime (Fedora 44 ships parallel-installable nodejsNN-bin stacks, no unversioned nodejs; this is the node 22 LTS the machine runs)
repo "nodejs22-npm-bin" # npm, paired with nodejs22-bin (the two own node and npm on PATH)
npm "@earendil-works/pi-coding-agent" # pi coding agent CLI
npm "@openai/codex" # OpenAI Codex CLI
npm-scripts "@opencode-ai/cli@beta" # opencode2 (the @opencode/cli scope is an empty placeholder with no beta tag; its postinstall fetches the platform binary, and without it the CLI is a stub that refuses to run)
npm-scripts "bun" # JavaScript runtime for Herdr Annotate's capture/manage actions (oven-sh's npm build; its postinstall fetches the platform binary)
# Claude Code is installed by dot itself, and herdr on both distros: their
# vendors' installers are the supported route (npm is deprecated for Claude).
#
# NVIDIA drivers are hardware-conditional and live in dot itself:
# ensure_nvidia installs rpmfusion and akmod-nvidia per
# docs.fedoraproject.org/en-US/gaming/drivers/ only when lspci finds NVIDIA
# hardware (run `./dot nvidia` to do it standalone).
